{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["face-service/**"]
  },
  "deploy": {
    "startCommand": "uvicorn main:app --host 0.0.0.0 --port 8080",
    "restartPolicyType": "ON_FAILURE"
  }
}
